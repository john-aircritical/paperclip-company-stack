# Required
ANTHROPIC_API_KEY=sk-ant-...
BETTER_AUTH_SECRET=generate-a-random-32-char-string

# Optional
OPENAI_API_KEY=
GOOGLE_API_KEY=
GITHUB_API_KEY=

# Ports
PAPERCLIP_PORT=3101
DASHBOARD_PORT=3102

# URL (set to your server IP/hostname if remote)
PAPERCLIP_PUBLIC_URL=http://localhost:3101

# UID/GID matching (for file permissions)
USER_UID=1000
USER_GID=1000
